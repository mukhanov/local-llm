#!/bin/sh
# local-llm — launcher: поднимает venv (зависимости — из pyproject.toml)
# и запускает пакет. Вся логика — в local_llm/.
set -e
APP_DIR=$(cd "$(dirname "$0")" && pwd)
OLLMLX="${OLLMLX_HOME:-$HOME/.ollmlx}"
VENV="$OLLMLX/venv"
STAMP="$OLLMLX/venv.deps"   # хэш pyproject.toml последней установки

command -v uv >/dev/null 2>&1 || {
  echo "uv is required: curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
}

mkdir -p "$OLLMLX"
if [ ! -x "$VENV/bin/python" ]; then
  uv venv "$VENV" --python 3.12
  rm -f "$STAMP"
fi

# единственный источник зависимостей — pyproject.toml; ставим пакет целиком
# (editable: git pull обновляет код без переустановки). Повторяем только когда
# pyproject изменился — обычный запуск ничего не качает.
hash=$( (sha256sum "$APP_DIR/pyproject.toml" 2>/dev/null \
         || shasum -a 256 "$APP_DIR/pyproject.toml") | cut -d' ' -f1)
if [ "$(cat "$STAMP" 2>/dev/null)" != "$hash" ]; then
  uv pip install --python "$VENV/bin/python" -e "$APP_DIR"
  printf '%s\n' "$hash" > "$STAMP"
fi

exec "$VENV/bin/local-llm" "$@"
