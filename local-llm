#!/bin/sh
# local-llm — launcher: sets up the venv (dependencies come from pyproject.toml)
# and runs the package. All the logic lives in local_llm/.
set -e
# $0 may be a symlink (~/bin/local-llm -> this checkout): resolve it, or
# APP_DIR becomes ~/bin and uv looks for pyproject.toml in the wrong place
SELF=$0
while [ -L "$SELF" ]; do
  LINK_DIR=$(cd "$(dirname "$SELF")" && pwd -P)
  SELF=$(readlink "$SELF")
  case $SELF in
    /*) ;;
    *) SELF=$LINK_DIR/$SELF ;;
  esac
done
APP_DIR=$(cd "$(dirname "$SELF")" && pwd -P)
OLLMLX="${OLLMLX_HOME:-$HOME/.ollmlx}"
VENV="$OLLMLX/venv"
STAMP="$OLLMLX/venv.deps"   # pyproject.toml hash of the last install

command -v uv >/dev/null 2>&1 || {
  echo "uv is required: curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
}

mkdir -p "$OLLMLX"
if [ ! -x "$VENV/bin/python" ]; then
  uv venv "$VENV" --python 3.12
  rm -f "$STAMP"
fi

# pyproject.toml is the single source of dependencies; install the whole
# package (editable: git pull updates the code without reinstalling).
# Re-run only when pyproject changes — a regular launch downloads nothing.
hash=$( (sha256sum "$APP_DIR/pyproject.toml" 2>/dev/null \
         || shasum -a 256 "$APP_DIR/pyproject.toml") | cut -d' ' -f1)
if [ "$(cat "$STAMP" 2>/dev/null)" != "$hash" ]; then
  uv pip install --python "$VENV/bin/python" -e "$APP_DIR"
  printf '%s\n' "$hash" > "$STAMP"
fi

exec "$VENV/bin/local-llm" "$@"
